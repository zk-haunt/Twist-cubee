# Copy this file to keystore.properties (which is git-ignored) to sign release builds with your
# own key. Without it, release builds are signed with the local debug key, for testing only.
#
# Create a key once with:
#   keytool -genkeypair -v -keystore twistcubee-release.jks -alias twistcubee -keyalg RSA -keysize 4096 -validity 10000
#
# Keep the .jks file and these passwords backed up somewhere safe and private: if you lose them,
# you can never publish an update to the same app listing again.
storeFile=twistcubee-release.jks
storePassword=change-me
keyAlias=twistcubee
keyPassword=change-me
