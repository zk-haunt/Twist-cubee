<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TwistCubee" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_bottom</item>
        <item name="android:colorBackground">@color/bg_bottom</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bg_top</item>
        <item name="android:colorPrimaryDark">@color/bg_bottom</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:alertDialogTheme">@style/Theme.TwistCubee.Dialog</item>
    </style>

    <style name="Theme.TwistCubee.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@drawable/bg_panel</item>
    </style>

    <!-- Dialogs and switches for AMOLED black and the light backgrounds (picked in code). -->
    <style name="Theme.TwistCubee.Dialog.Black">
        <item name="android:windowBackground">@drawable/bg_panel_black</item>
    </style>

    <style name="Theme.TwistCubee.Dialog.Light" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/light_accent</item>
        <item name="android:windowBackground">@drawable/bg_panel_light</item>
        <!-- Like light_scrim: keep the screen light behind the dialog (e-ink). -->
        <item name="android:backgroundDimAmount">0.25</item>
    </style>

    <style name="Theme.TwistCubee.LightControls" parent="@android:style/Theme.Material.Light">
        <item name="android:colorAccent">@color/light_accent</item>
        <item name="android:colorControlActivated">@color/light_accent</item>
    </style>
</resources>
