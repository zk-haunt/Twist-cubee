<?xml version="1.0" encoding="utf-8"?>
<!-- bg_chip for light backgrounds. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/light_ripple">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent_soft" />
                    <stroke android:width="1.5dp" android:color="@color/light_accent" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#0A000000" />
                    <stroke android:width="1dp" android:color="#26000000" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
